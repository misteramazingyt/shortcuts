# Build output. Generated by scripts/build_and_sign.sh and published as
# Codemagic artifacts, never committed. Source lives in shortcuts/.
build/

__pycache__/
*.pyc
.DS_Store

# Apple ID signing material. NEVER commit these — the private key is your
# Apple identity, and anyone holding it can sign as you. They belong in CI
# secrets, not in git.
*.key
*.p12
*.p8
authData.plist
privateKey.bin
auth_data*
appleid-dump/
signing-identity/

# Generated n8n workflow JSON (deploy artifact, not source)
n8n/**/n8n_*.json
